# Copy to .env.local and adjust.

# Base URL of the Express API, including the /api prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001/api

# Public origin of this site — used for canonical URLs, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:5199

# Show dashed placeholders where an ad slot has nothing booked (useful in development).
NEXT_PUBLIC_AD_PLACEHOLDER=false
