# TechCruncher API — copy to .env and fill in. Never commit the filled copy.
NODE_ENV=development
PORT=7000

# MongoDB connection string. Use a separate database for local development.
MONGO_URI=

# Auth (JWT_SECRET is required; the server refuses to start without it)
JWT_SECRET=
JWT_EXPIRE=7d

# Extra CORS origins, comma separated (production domains are built in)
ALLOWED_ORIGINS=

# Public site origin, used in newsletter and reply emails
SITE_URL=https://techcruncher.com

# Cloudinary (media uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound mail (contact replies, newsletter). Leave empty to disable email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="TechCruncher <newsroom@techcruncher.com>"

# AI auto-news. The cron only runs when ENABLE_AUTO_NEWS is "true" — enable it on ONE instance.
ENABLE_AUTO_NEWS=false
CRON_TIME=0 2 * * *
GEMINI_API_KEY=
GNEWS_API_KEY=
